
@{
    ViewBag.Title = "Task Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .select2-container {
        margin-bottom: 15px;
    }
</style>

<div class="content-wrapper">
    <section class="content-header">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="mb-0">Team Members</h4>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="col-lg-12 col-md-6 col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        My Team Members Tasks Log
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group row">
                                <label for="project" class="control-label col-lg-4">Project Name</label>
                                <div class="col-lg-8">
                                    <select id="project" name="project" class="form-control select2"></select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label for="drpick" class="control-label col-lg-4">Searh by Date</label>
                                <div class="col-lg-8">
                                    <div class="input-group date-container">
                                        <input id="drpick" name="drpick" class="form-control datepick" data-input />
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-default" data-clear><i class="fas fa-times"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-lg-12">
                                    <span class="btn btn-secondary" id="btnClear"><i class="fas fa-times-circle"></i> Clear</span>
                                    <span class="btn btn-primary float-right" id="btnSearch"><i class="fas fa-search"></i> Search</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--<div class="row justify-content-around">
                        <div class="col-4">
                            <label for="drpick" class="control-label">Searh by Date</label>
                        </div>
                        <div class="col-4">
                            <input id="drpick" name="drpick" class="form-control datepick" />
                        </div>
                        <div class="col-4">
                            <span class="btn btn-primary" id="btnSearch"><i class="fas fa-search"></i> Search</span>-->
                            @*<span class="btn btn-success float-right" id="btnExportExcel"><i class="fas fa-file-excel"></i> Export</span>*@
                        <!--</div>
                    </div>-->
                    <br />
                    <div class="col-12">
                        <table class="table table-sm table-striped" id="tblTasks">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Badge ID</th>
                                    <th>Name</th>
                                    <th>Project Name</th>
                                    <th>Capex Number</th>
                                    <th>Job Type</th>
                                    <th>Start</th>
                                    <th>Stop</th>
                                    <th>Duration</th>
                                    <th>Duration (mins)</th>
                                    <th>Activity</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>
<script>
    var tbl = null;
    var fp = [];
    $(document).ready(function () {
        tbl = new DataTable($('#tblTasks'), {
            scrollX: true,
            columnDefs: [
                { "className": "dt-center", "targets": "_all" }
            ],
            layout: {
                top1End: {
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            className: 'btn btn-success',
                            text: 'Export to Excel',
                            filename: 'Task Log - ' + moment().format('YYYY-MM-DD_HH.mm.ss'),

                            customize: function (xlsx) {
                                var sheet = xlsx.xl.worksheets['sheet1.xml'];
                                var styles = xlsx.xl['styles.xml'];

                                // ==========================================
                                // 1. ADD LIGHT GRAY FILL (For Zebra Striping)
                                // ==========================================
                                var fills = $('fills', styles);
                                var fillCount = parseInt(fills.attr('count'));
                                // FFF2F2F2 is Excel's hex code for standard light gray
                                fills.append('<fill><patternFill patternType="solid"><fgColor rgb="FFF2F2F2"/></patternFill></fill>');
                                fills.attr('count', fillCount + 1);
                                var fillGrayId = fillCount; // Save the ID of our new fill

                                // ==========================================
                                // 2. ADD THIN BORDERS
                                // ==========================================
                                var borders = $('borders', styles);
                                var borderCount = parseInt(borders.attr('count'));
                                borders.append('<border><left style="thin"/><right style="thin"/><top style="thin"/><bottom style="thin"/></border>');
                                borders.attr('count', borderCount + 1);
                                var borderThinId = borderCount; // Save the ID of our new border

                                // ==========================================
                                // 3. CLONE STYLES (To preserve dates/numbers)
                                // ==========================================
                                var cellXfs = $('cellXfs', styles);
                                var xfCount = parseInt(cellXfs.attr('count'));
                                var styleMap = {};

                                // We loop through all default styles and create two new versions of each:
                                // One with just a border (for odd rows), and one with a border + fill (for even rows)
                                $('xf', cellXfs).each(function (index) {
                                    var $xf = $(this);

                                    // A: Create "Odd Row" style (Border only)
                                    var $oddStyle = $xf.clone();
                                    $oddStyle.attr('borderId', borderThinId).attr('applyBorder', '1');
                                    cellXfs.append($oddStyle);
                                    var oddId = xfCount++;

                                    // B: Create "Even Row" style (Border + Gray Fill)
                                    var $evenStyle = $xf.clone();
                                    $evenStyle.attr('borderId', borderThinId).attr('applyBorder', '1');
                                    $evenStyle.attr('fillId', fillGrayId).attr('applyFill', '1');
                                    cellXfs.append($evenStyle);
                                    var evenId = xfCount++;

                                    // Save mapping so we know which styles to swap later
                                    styleMap[index] = { odd: oddId, even: evenId };
                                });

                                cellXfs.attr('count', xfCount); // Update the total styles count

                                // ==========================================
                                // 4. APPLY STYLES TO THE EXCEL ROWS
                                // ==========================================
                                $('row', sheet).each(function (rowIndex) {
                                    var $row = $(this);

                                    // Row 0 is the Header. 
                                    // Check if the row index is an even number (2, 4, 6...)
                                    var isEvenRow = (rowIndex !== 0 && rowIndex % 2 === 0);

                                    $row.find('c').each(function () {
                                        var $cell = $(this);
                                        // Get the original style (or default to 0)
                                        var originalStyle = $cell.attr('s') || 0;

                                        // Overwrite it with our mapped custom style
                                        if (isEvenRow) {
                                            $cell.attr('s', styleMap[originalStyle].even);
                                        } else {
                                            $cell.attr('s', styleMap[originalStyle].odd);
                                        }
                                    });
                                });

                                // ==========================================
                                // 5. AUTO-FILTER INJECTION
                                // ==========================================
                                var totalRows = $('row', sheet).length;
                                // Starts at A1 to ensure the headers get the filter arrows!
                                var fullRange = 'A2:J' + totalRows;
                                $('sheetData', sheet).after('<autoFilter ref="' + fullRange + '"/>');
                            },
                        }
                    ]
                }
            }
        });

        // 1. Get the current date and day of the month
        const today = new Date();
        const currentDay = today.getDate();

        let startDate;

        // 2. Apply your conditional logic
        if (currentDay < 26) {
            // 26th day of the previous month
            startDate = new Date(today.getFullYear(), today.getMonth() - 1, 26);
        } else {
            // 26th day of the current month (handles day 25, 26, and above)
            startDate = new Date(today.getFullYear(), today.getMonth(), 26);
        }

        // 3. Initialize Flatpickr with the dynamic range
        fp = flatpickr(".date-container", {
            wrap: true,
            mode: "range",
            altInput: true,
            altFormat: "j M Y",
            dateFormat: "Y-m-d",
            maxDate: "today",
            defaultDate: [startDate, "today"]
        });

        loadTaskDropdown();
        $('.select2').css('width', '100%');
        $('.select2').select2({ theme: 'bootstrap4' });

        if ($('#drpick').val() || $('#project').val()) {
            loadLog();
        }
    });


    function loadTaskDropdown() {
        $.get('/Tracker/GetTaskList', { nolimit: true }, function (res) {
            if (res.flag == 'success') {
                var opts = res.data.map(function (t) {
                    return '<option value="' + t.Id + '">' + t.Id + ' | ' + t.taskTitle + '</option>';
                }).join('');
                opts = '<option value="">-</option>' + opts;
                $('#project').html(opts);
            } else {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }

    $('#btnSearch').on('click', (e) => {
        e.preventDefault();
        loadLog();
    });

    $('#btnClear').on('click', (e) => {
        e.preventDefault();
        fp.clear();
        $('#project').val('').trigger('change');
    });

    function loadLog() {
        debugger;
        var dateRange = getDateRange();
        var project = $('#project').val();
        if (dateRange.length == 0 && project.trim() == '') {
            notify('Please atleast fill project or date range first.', 'warning');
            return;
        }
        $.get('/Team/GetTaskLog', { startD: dateRange[0], stopD: dateRange[1], project: project }, function (res) {
            if (res.flag == 'success') {
                tbl.clear().draw();
                for (var i = 0; i < res.data.length; i++) {
                    tbl.row.add([
                        i + 1,
                        res.data[i].badgeId,
                        res.data[i].fullName,
                        res.data[i].taskTitle,
                        res.data[i].cpxNumber ?? '-',
                        res.data[i].jobType,
                        moment(res.data[i].startDatetime).format('DD MMM YYYY HH:mm:ss'),
                        res.data[i].stopDatetime ? moment(res.data[i].stopDatetime).format('DD MMM YYYY HH:mm:ss') : '-',
                        res.data[i].duration ? formatSeconds(res.data[i].duration) : '-',
                        res.data[i].duration ? Math.round(res.data[i].duration / 60) : '-',
                        res.data[i].activity ?? '-',
                        res.data[i].remarks ?? '-',
                    ]);
                }
                tbl.draw();
            } else if (res.flag == 'warning') {
                notify(res.msg, res.flag);
                tbl.clear().draw();
            } else {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }

    function getDateRange() {
        var result = [];
        if ($('#drpick').val()) {
            var drpick = $('#drpick').val().split(' ');
            result.push(drpick[0]);
            result.push(drpick[2] ?? drpick[0]);
        }
        return result;
    }

</script>