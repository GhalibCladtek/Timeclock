@{ ViewBag.Title = "Index";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CladTask | Log in</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css">
    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="~/adminlte/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="~/adminlte/plugins/toastr/toastr.min.css">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="login-logo">
            <a href="#"><b>Clad</b>Task</a>
        </div>
        <!-- /.login-logo -->
        <div class="card">
            <div class="card-body login-card-body">
                <p class="login-box-msg">Sign in to start your session</p>

                <form id="formLogin">
                    <input type="hidden" id="ReturnUrl" name="ReturnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Username" id="user">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-user"></span>
                            </div>
                        </div>
                    </div>
                    <div class="input-group mb-3">
                        <input type="password" class="form-control" placeholder="Password" id="pass">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="icheck-primary">
                                <input type="checkbox" id="rememberMe">
                                <label for="rememberMe">
                                    Remember Me
                                </label>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-4">
                            <button type="button" id="btnLogin" class="btn btn-primary btn-block">Sign In</button>
                        </div>
                        <!-- /.col -->
                    </div>
                </form>

                <p class="mb-1 text-center">
                    Doesn't have an account? <a href="#" id="btnRegister" class="text-center">Register here</a>
                </p>
            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
    <!-- /.login-box -->

    <div id="divMdl"></div>

    <!-- jQuery -->
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/adminlte/dist/js/adminlte.min.js"></script>
    <!-- Toastr -->
    <script src="~/adminlte/plugins/toastr/toastr.min.js"></script>
    <!-- Cookies Handler -->
    <script src="~/Scripts/CookieMaster.js"></script>
    <!-- jQuery Validator -->
    <script src="~/adminlte/plugins/jquery-validation/jquery.validate.js"></script>

    <script>
        let isSubmitting = false;

        $(document).ready(function () {
            $("#user").val(getCookie('AuthCookie'));
            if ('@TempData["message"]'.trim()) {
                let type = '@TempData["code"]'.trim() ?? 'info';
                notify('@TempData["message"]', type);
            }
        }).on('keydown', function (event) {
            if (event.key === 'Enter' || event.which === 13) {
                event.preventDefault(); // Prevents default actions like submitting a form
                $('#btnLogin').trigger('click');
            }
        });

        $('#btnLogin').on('click', (e) => {
            e.preventDefault();
            if (!$("#user").val().trim()) {
                toastr.warning('Username cannot be empty');
                return;
            }
            if (!$("#pass").val().trim()) {
                toastr.warning('Password cannot be empty');
                return;
            }

            if (isSubmitting) return;
            isSubmitting = true;

            let $btn = $("#btnLogin");
            let originalText = $btn.text();
            $btn.prop("disabled", true).text("Logging in...");

            $.post('@Url.Action("Login")', { user: $("#user").val(), pass: $("#pass").val(), rememberMe: $("#rememberMe").prop('checked'), rUrl: $('#ReturnUrl').val() }, (res) => {
                if (res.flag == 'success') {
                    notify(res.msg + '\n' + 'Please wait you will be redirected.', res.flag);
                    setTimeout(function () {
                        window.location.href = res.url;
                    }, 1500);
                    window.location.href = res.url;
                } else {
                    notify(res.msg, res.flag);
                    console.log(res.data);
                    isSubmitting = false;
                    $btn.prop("disabled", false).text(originalText);
                }
            }).fail(function () {
                notify("A network error occurred. Please try again.", "error");
                isSubmitting = false;
                $btn.prop("disabled", false).text(originalText);
            });
        });

        function notify(msg, type) {
            toastr.options = {
                "closeButton": false,
                "debug": false,
                "newestOnTop": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            }

            if (type == 'success') {
                toastr["success"](msg);
            } else if (type == 'warning') {
                toastr["warning"](msg);
            } else if (type == 'error' || type == 'failed') {
                toastr["error"](msg);
            } else {
                toastr["info"](msg);
            }
        }

        $('#btnRegister').on('click', (e) => {
            e.preventDefault();
            notify('Register account still under construction', 'Info');
            return;
            $.get('@Url.Action("Register", "Account")', {}, (res) => {
                if (!res.flag) {
                    $('#divMdl').html(res);
                } else {
                    notify(res.msg, res.flag);
                    console.log(res.data);
                }
            });
        })
    </script>
</body>
</html>


