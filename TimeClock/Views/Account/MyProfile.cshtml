
@{
    ViewBag.Title = "MyProfile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = (TimeClock.Models.TblUsers)ViewBag.User;
}

@Html.AntiForgeryToken()
<div class="content-wrapper">
    <div class="container mt-4">
        <section class="content-header">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="mb-0">Profile</h4>
                </div>
            </div>
        </section>
        <section class="content">
            <div class="col-lg-6 col-md-6 col-sm-12">
                <div class="card">
                    <div class="card-header ui-sortable-handle" style="cursor: move;">
                        <h3 class="card-title">
                            My Profile
                        </h3>
                        <div class="card-tools">
                            <ul class="nav nav-pills ml-auto">
                                <li class="nav-item">
                                    <a class="nav-link active" href="#profile" data-toggle="tab">Profile</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#change-pass" data-toggle="tab">Change Password</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="tab-content p-0">
                        <div class="tab-pane active" id="profile">
                            <div class="card-body">
                                @*<div class="form-group">
                                    <label for="username" class="control-label">Username</label>
                                    <input id="username" class="form-control" value="@user.username" readonly />
                                </div>*@
                                <div class="form-group">
                                    <label for="badgeId" class="control-label">Badge ID</label>
                                    <input id="badgeId" class="form-control" value="@user.badgeId" readonly />
                                </div>
                                <div class="form-group">
                                    <label for="fullName" class="control-label">Full Name</label>
                                    <input id="fullName" class="form-control" value="@user.fullName" />
                                </div>
                                <div class="form-group">
                                    <label for="title" class="control-label">Title</label>
                                    <input id="title" class="form-control" value="@user.title" />
                                </div>
                                <div class="form-group">
                                    <label for="role" class="control-label">Roles</label>
                                    <select class="select2" id="role"></select>
                                </div>
                            </div>
                            <div class="card-footer">
                                <span class="btn btn-primary" id="btnSaveProfile">Save</span>
                            </div>
                        </div>

                        <div class="tab-pane" id="change-pass">
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="pass">Old Password</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="pass" placeholder="Current Password">
                                        <span class="input-group-append">
                                            <button type="button" class="btn btn-flat" id="passEye"><i class="fas fa-eye-slash"></i></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="pass1">New Password</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="pass1" placeholder="New Password">
                                        <span class="input-group-append">
                                            <button type="button" class="btn btn-flat" id="pass1Eye"><i class="fas fa-eye-slash"></i></button>
                                        </span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="pass2">Confirm Password</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="pass2" placeholder="Old Password">
                                        <span class="input-group-append">
                                            <button type="button" class="btn btn-flat" id="pass2Eye"><i class="fas fa-eye-slash"></i></button>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <span class="btn btn-primary" id="btnUpdatePass">Save</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </div>
</div>
<script>
    $(document).ready(() => {
        getroles();
        $('.select2').css('width', '100%');
        $('.select2').select2({ theme: 'bootstrap4' });
    });

    function antiForgeryToken() {
        return $('input[name="__RequestVerificationToken"]').val();
    }

    function getroles() {
        $.get('@Url.Action("GetRoleList")', {}, (res) => {
            if (res.flag == 'success') {
                if (res.data) {
                    var opts = '';
                    for (var i = 0; i < res.data.length; i++) {
                        opts += '<option value="' + res.data[i] + '" ' +
                            ('@user.role' == res.data[i] ? 'selected' : '')
                            +'>' + res.data[i] + '</option>';
                    }
                    $('#role').html(opts);
                } else {
                    notify('Somehow the role is empty.', 'warning');
                }
            } else {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }

    $('#btnSaveProfile').on('click', (e) => {
        e.preventDefault();
        $.post('@Url.Action("SaveProfile")', {
            id: (@user.Id)
            , fullName: $('#fullName').val()
            , title: $('#title').val()
            , role: $('#role').val()
        }, (res) => {
            notify(res.msg, res.flag);
            console.log(res.data);
        });
    });

    $('button[id*=Eye]').on('click', (e) => {
        debugger;
        $input = $('#' + e.currentTarget.id.replaceAll('Eye', ''));

        if ($(e.currentTarget).html().includes('slash')) {
            $(e.currentTarget).html('<i class="fas fa-eye"></i>')
            $input.prop('type', 'text');
        } else {
            $(e.currentTarget).html('<i class="fas fa-eye-slash"></i>')
            $input.prop('type', 'password');
        }

    });

    // Helper function to show errors directly under the specific input group
    function showError(inputId, message) {
        $(inputId).closest('.input-group').after('<small class="text-danger pass-error mt-1 d-block">' + message + '</small>');
        isValid = false;
    }

    // 2. Form Validation on Save Button Click
    $('#btnUpdatePass').on('click', function (e) {
        e.preventDefault(); // Prevent accidental form submission

        // Clear any previous error messages
        $('.pass-error').remove();

        let oldPass = $('#pass').val();
        let newPass = $('#pass1').val();
        let confirmPass = $('#pass2').val();
        let isValid = true;

        // Rule A: Old password cannot be empty
        if (oldPass.trim() === '') {
            showError('#pass', 'Please enter your current password.');
        }

        // Rule B: New password must be at least 4 characters
        if (newPass.length < 4) {
            showError('#pass1', 'New password must be at least 4 characters long.');
        }

        // Rule C: Confirm password must exactly match the new password
        if (confirmPass === '') {
            showError('#pass2', 'Please confirm your new password.');
        } else if (newPass !== confirmPass) {
            showError('#pass2', 'Passwords do not match.');
        }

        // --- Final Submission ---

        if (isValid) {
            $.post('@Url.Action("UpdatePassword")', {
                id: (@user.Id)
                , oldPass: $('#pass').val()
                , newPass: $('#pass1').val()
                , confirmPass: $('#pass2').val()
            }, (res) => {
                notify(res.msg, res.flag);
                console.log(res.data);
            });
        }
    });

    // Optional: Real-time clearing of errors as the user types
    $('#pass, #pass1, #pass2').on('input', function () {
        $(this).closest('.form-group').find('.pass-error').remove();
    });
</script>