<!DOCTYPE html>
<!--
This is a starter template page. Use this page to start your new project from
scratch. This page gets rid of all links and provides the needed markup only.
-->
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title | CladTask</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="~/adminlte/plugins/sweetalert2/sweetalert2.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="~/adminlte/plugins/toastr/toastr.min.css">
    <!-- Date Range Picker -->
    <link rel="stylesheet" href="~/adminlte/plugins/daterangepicker/daterangepicker.css">
    <!-- iCheck -->
    <link rel="stylesheet" href="~/adminlte/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <!-- Select2 -->
    <link rel="stylesheet" href="~/adminlte/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
    <!-- Flatpickr - Lightweight Date or Time Picker -->
    <link rel="stylesheet" href="~/adminlte/plugins/flatpickr/flatpickr.min.css">
    <!-- Datatable -->
    <link rel="stylesheet" href="~/adminlte/plugins/datatables/datatables.css">

    <!-- REQUIRED SCRIPTS -->
    <!-- jQuery -->
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/adminlte/dist/js/adminlte.min.js"></script>
    <!-- Moment Js -->
    <script src="~/adminlte/plugins/moment/moment.min.js"></script>
    <!-- Sweetalert -->
    <script src="~/adminlte/plugins/sweetalert2/sweetalert2.js"></script>
    <!-- Toastr -->
    <script src="~/adminlte/plugins/toastr/toastr.min.js"></script>
    <!-- Date Range Picker -->
    <script src="~/adminlte/plugins/daterangepicker/daterangepicker.js"></script>
    <!-- Select2 -->
    <script src="~/adminlte/plugins/select2/js/select2.full.min.js"></script>
    <!-- Flatpickr - Lightweight Date or Time Picker -->
    <script src="~/adminlte/plugins/flatpickr/flatpickr.js"></script>
    <!-- Cookies Handler -->
    <script src="~/Scripts/CookieMaster.js"></script>
    <!-- jQuery Validator -->
    <script src="~/adminlte/plugins/jquery-validation/jquery.validate.js"></script>
    <!-- Datatable -->
    <script src="~/adminlte/plugins/datatables/datatables.js"></script>

    <!-- Loading css -->
    <style>
        .loader {
            width: 40px;
            height: 40px;
            --c: no-repeat linear-gradient(#85c1f3 0 0);
            background: var(--c),var(--c),var(--c),var(--c);
            background-size: 21px 21px;
            animation: l5 1.5s infinite cubic-bezier(0.3,1,0,1);
            position: absolute;
            position: fixed;
            z-index: 99999;
            margin: auto;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
        }

        @@keyframes l5 {
            0% {
                background-position: 0 0,100% 0,100% 100%,0 100%
            }

            33% {
                background-position: 0 0,100% 0,100% 100%,0 100%;
                width: 60px;
                height: 60px
            }

            66% {
                background-position: 100% 0,100% 100%,0 100%,0 0;
                width: 60px;
                height: 60px
            }

            100% {
                background-position: 100% 0,100% 100%,0 100%,0 0
            }
        }

        .loading {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: black;
            opacity: 0.5;
            z-index: 99990;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #007bff;
            border-color: #006fe6;
        }
        
        .content-wrapper {
            min-height: 80vh !important; /* Forces the main content area to fill the screen viewport */
        }
    </style>

</head>
<body class="hold-transition sidebar-collapse layout-top-nav">
    <div class="loading" style="display:none;">
        <div class="loader"></div>
    </div>
    <div class="wrapper">
        @Html.Partial("~/Views/Shared/_TopNavBar.cshtml")
        @Html.Partial("~/Views/Shared/_LeftSideBar.cshtml")

        @RenderBody()

        <footer class="main-footer">
            <div class="float-right d-none d-sm-inline">
                CladTask - Automation and Design Department
            </div>
            <strong>Copyright &copy; @DateTime.Now.Year PEPP Department.</strong> All rights reserved.
        </footer>
    </div>

    <script>
        $(document).ready(function () {
            if ('@TempData["message"]'.trim()) {
                let type = '@TempData["code"]'.trim() ?? 'info';
                notify('@TempData["message"]', type);
            }

            $(document).ajaxError(function (event, jqXHR, ajaxSettings, thrownError) {
                debugger;
                if (jqXHR.status === 401) {
                    // Session expired! Redirect them to your login page.
                    // Adjust the URL to match your actual login route
                    window.location.href = '/Login/Index?ReturnUrl=' + encodeURIComponent(window.location.pathname);
                } else {
                    notify('An error occurred. Please try again. Error code ' + jqXHR.status, 'error');
                    // Optional: Log the actual error to the console for debugging
                    console.error("AJAX Error on " + ajaxSettings.url + ": ", thrownError);
                }
            });
        })

        $(document).on('select2:open', () => {
            document.querySelector('.select2-search__field').focus();
        });

        function jAlert(msg, title, callback = null) {
            if (title === undefined) {
                Swal.fire({
                    title: msg,
                    customClass: {
                        confirmButton: "btn btn-success",
                    },
                    buttonsStyling: false
                }).then((res) => {
                    if (callback != null) {
                        callback();
                    }
                });
            } else {
                Swal.fire({
                    title: title,
                    text: msg,
                    customClass: {
                        confirmButton: "btn btn-success",
                    },
                    buttonsStyling: false
                }).then((res) => {
                    if (callback != null) {
                        callback();
                    }
                });
            }
        }

        function jConfirm(msg, title, callback) {
            msg = msg.replaceAll('\n', '<br>');
            Swal.fire({
                title: title,
                html: msg,
                showCancelButton: true,
                confirmButtonText: "Confirm",
            }).then((result) => {
                if (callback != null) {
                    callback(result.isConfirmed);
                } else {
                    return result;
                }
            });
        }

        function notify(msg, type) {
            toastr.options = {
                "closeButton": false,
                "debug": false,
                "newestOnTop": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "preventDuplicates": false,
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            }

            if (type == 'success') {
                toastr["success"](msg);
            } else if (type == 'warning') {
                toastr["warning"](msg);
            } else if (type == 'error' || type == 'failed') {
                toastr["error"](msg);
            } else {
                toastr["info"](msg);
            }
        }

        //convert from second into H m s
        function formatSeconds(totalSeconds) {
            const duration = moment.duration(totalSeconds, 'seconds');
            const hours = Math.floor(duration.asHours());
            const minutes = duration.minutes();
            const seconds = duration.seconds();

            const parts = [
                hours > 0 ? `${hours}h` : null,
                minutes > 0 ? `${minutes}m` : null,
                seconds > 0 ? `${seconds}s` : null
            ].filter(Boolean); // Removes all null entries
            return parts.join(' ') || '0s';
        }
    </script>

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</body>

</html>