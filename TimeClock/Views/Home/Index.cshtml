@{
    ViewBag.Title = "Home Page";
}

<div class="content-wrapper">
    <div class="container">
        <section class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1>Dashboard</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item active"><a href="/Home/Index">Home</a></li>
                        </ol>
                    </div>
                </div>
            </div><!-- /.container-fluid -->
        </section>
        <section class="content">
            <div class="row">
                <div class="col-12">
                    <div id="taskSummaryDiv"></div>
                </div>
            </div>
        </section>
    </div>
</div>
<script>
    $(document).ready(function () {
        getSummaryTask();
    });

    function getSummaryTask() {
        $.get('@Url.Action("TaskSummary")', {}, (res) => {
            if (!res.flag) {
                $('#taskSummaryDiv').html(res);
            } else {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }
</script>