@{ 
    ViewBag.Title = "Clad Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var responsibleSection = new List<SelectListItem>();
    responsibleSection.Add(new SelectListItem() { Text = "-", Value = "" });
    responsibleSection.Add(new SelectListItem() { Text = "Electrical", Value = "Electrical" });
    responsibleSection.Add(new SelectListItem() { Text = "Automation", Value = "Automation" });
    responsibleSection.Add(new SelectListItem() { Text = "SCADA", Value = "SCADA" });
    responsibleSection.Add(new SelectListItem() { Text = "Design", Value = "Design" });
    responsibleSection.Add(new SelectListItem() { Text = "Technical Writer", Value = "Technical Writer" });
    responsibleSection.Add(new SelectListItem() { Text = "Commisioning", Value = "Commisioning" });
    responsibleSection.Add(new SelectListItem() { Text = "Other", Value = "Other" });
}
@Html.AntiForgeryToken()
<div class="content-wrapper">
    <div class="container mt-4">
        <section class="content-header">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="mb-0">@ViewBag.FullName</h4>
                    <small class="text-muted">Badge: @ViewBag.BadgeId &middot; @ViewBag.Section</small>
                </div>
            </div>
        </section>
        <section class="content">
            <!-- STATE PANEL: no task running -->
            <div id="noTaskPanel" class="card border-secondary mb-4" style="display:none;">
                <div class="card-body">
                    <span class="text-muted">No task currently running.</span>
                    <button id="btnOpenStartModal" class="btn btn-primary float-right">Start Task</button>
                </div>
            </div>

            <!-- STATE PANEL: task running -->
            <div id="runningTaskPanel" class="card border-success mb-4" style="display:none;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge badge-success mb-2">RUNNING</span>
                            <h5 class="mb-1" id="runningTaskTitle"></h5>
                            <div class="text-muted" id="runningJobType"></div>
                            <div class="text-muted">Started: <span id="runningStart"></span></div>
                            <div class="text-muted" id="runningRemarksWrap" style="display:none;">
                                Remarks: <span id="runningRemarks"></span>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="display-4" id="elapsedTimer">00:00:00</div>
                            <button id="btnStopTask" class="btn btn-danger mt-2">Stop Task</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- HISTORY -->
            <div class="card">
                <div class="card-header">Activity History</div>
                <div class="card-body">
                    <table class="table table-sm table-striped" id="historyTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Task Title</th>
                                <th>Job Type</th>
                                <th>Start</th>
                                <th>Stop</th>
                                <th>Duration (min)</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

        </section>
    </div>
</div>

<!-- START TASK MODAL -->
<div class="modal fade" id="startTaskModal" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Start Task</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div id="jobTypeNotice" class="alert alert-warning" style="display:none;">
                    Outside working hours / weekend: only <strong>Operational</strong> is available.
                </div>

                <div class="form-group">
                    <label class="control-label">Project Name</label>
                    @Html.DropDownList("taskSelect", new List<SelectListItem>(), new { @id = "taskSelect", @class = "select2" })
                </div>
                <div id="projectDescription" class="alert alert-secondary">
                </div>
                <div class="form-group">
                    <label class="control-label">Activity Section Type</label>
                    @Html.DropDownList("sectionSelect", responsibleSection, new { @id = "sectionSelect", @class = "select2" })
                </div>

                <div class="form-group">
                    <label>Job Type</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="jobType" id="jobTypeDev" value="Development">
                            <label class="form-check-label" for="jobTypeDev">Development</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="jobType" id="jobTypeOps" value="Operational">
                            <label class="form-check-label" for="jobTypeOps">Operational</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Remarks (optional)</label>
                    <textarea id="remarksInput" class="form-control" rows="2"></textarea>
                </div>

                <div id="startTaskError" class="alert alert-danger" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button id="btnConfirmStart" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    var timerInterval = null;
    var currentStart = null;
    var CURRENT_BADGE_ID = '@ViewBag.BadgeId';
    var CURRENT_FULL_NAME = '@ViewBag.FullName';
    var CURRENT_SECTION = '@ViewBag.Section';
    var tbl = null;
    $(document).ready(function () {
        // ---------- init ----------
        loadOpenTask();
        loadHistory();

        tbl = new DataTable($('#historyTable'), {
            scrollX: true,
            "columnDefs": [
                { "className": "dt-center", "targets": "_all" }
            ],
        });
        $('#projectDescription').hide();
    });

    $('#startTaskModal').on('show.bs.modal', function () {
        $('.select2').css('width', '100%');
        $('.select2').select2({ dropdownParent: $('#startTaskModal'), theme: 'bootstrap4'});
        //$('.select2').select2({ dropdownParent: $('#startTaskModal') });
    });

    function antiForgeryToken() {
        return $('input[name="__RequestVerificationToken"]').val();
    }

    // ---------- state rendering ----------

    function showNoTaskPanel() {
        clearInterval(timerInterval);
        $('#runningTaskPanel').hide();
        $('#noTaskPanel').show();
    }

    function showRunningPanel(task) {
        $('#noTaskPanel').hide();
        $('#runningTaskPanel').show();

        $('#runningTaskTitle').text(task.taskTitle);
        $('#runningJobType').text(task.jobType);
        $('#runningStart').text(moment(task.startDatetime).format('DD MMM YYYY HH:mm:ss'));

        if (task.remarks) {
            $('#runningRemarks').text(task.remarks);
            $('#runningRemarksWrap').show();
        } else {
            $('#runningRemarksWrap').hide();
        }

        //currentStart = new Date(task.startDatetime);
        currentStart = moment(task.startDatetime);
        $('#runningTaskPanel').data('logId', task.Id);

        clearInterval(timerInterval);
        tickTimer();
        timerInterval = setInterval(tickTimer, 1000);
    }

    function tickTimer() {
        var diffMs = moment() - currentStart;
        var totalSec = Math.max(0, Math.floor(diffMs / 1000));
        var h = Math.floor(totalSec / 3600);
        var m = Math.floor((totalSec % 3600) / 60);
        var s = totalSec % 60;
        var pad = function (n) { return n < 10 ? '0' + n : n; };
        $('#elapsedTimer').text(pad(h) + ':' + pad(m) + ':' + pad(s));
    }

    // ---------- data loading ----------

    function loadOpenTask() {
        $.get('/Tracker/GetOpenTask', function (res) {
            if (res.flag = 'success') {
                if (res.data) {
                    showRunningPanel(res.data);
                } else {
                    showNoTaskPanel();
                }
            } else {
                showNoTaskPanel();
            }
        });
    }

    function loadHistory() {
        $.get('/Tracker/GetHistory', { page: 1, pageSize: 20 }, function (res) {
            if (res.flag == 'success') {
                tbl.clear().draw();
                for (var i = 0; i < res.data.items.length; i++) {
                    tbl.row.add([
                        i+1,
                        res.data.items[i].taskTitle,
                        res.data.items[i].jobType,
                        moment(res.data.items[i].startDatetime).format('DD MMM YYYY HH:mm:ss'),
                        res.data.items[i].stopDatetime ? moment(res.data.items[i].stopDatetime).format('DD MMM YYYY HH:mm:ss') : '-',
                        res.data.items[i].duration ? formatSeconds(res.data.items[i].duration) : '-',
                        res.data.items[i].remarks,

                    ]);
                }
                tbl.draw();
                //var rows = res.data.items.map(function (r) {
                //    return '<tr>' +
                //        '<td>' + r.taskTitle + '</td>' +
                //        '<td>' + r.jobType + '</td>' +
                //        '<td>' + new Date(r.startDatetime).toLocaleString() + '</td>' +
                //        '<td>' + (r.stopDatetime ? new Date(r.stopDatetime).toLocaleString() : '-') + '</td>' +
                //        '<td>' + (r.duration != null ? r.duration : '-') + '</td>' +
                //        '<td>' + (r.remarks || '') + '</td>' +
                //        '</tr>';
                //}).join('');
                //$('#historyTable tbody').html(rows);
            } else if(res.flag == 'error') {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }

    function loadTaskDropdown() {
        $.get('/Tracker/GetTaskList', function (res) {
            if (res.flag == 'success') {
                var opts = res.data.map(function (t) {
                    return '<option value="' + t.Id + '">' + t.taskTitle + '</option>';
                }).join('');
                opts = '<option value="">-</option>' + opts;
                $('#taskSelect').html(opts);
            } else {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }

    function applyJobTypeRules() {
        $.get('/Tracker/GetJobTypeOptions', function (res) {
            if (res.flag == 'success') {
                var allowed = res.data;

                $('#jobTypeDev, #jobTypeOps').prop('disabled', false).prop('checked', false);

                if (allowed.indexOf('Development') === -1) {
                    $('#jobTypeDev').prop('disabled', true);
                    $('#jobTypeOps').prop('checked', true);
                    $('#jobTypeNotice').show();
                } else {
                    $('#jobTypeNotice').hide();
                }
            } else {
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        });
    }

    // ---------- actions ----------

    $('#btnOpenStartModal').on('click', function () {
        $('#startTaskError').hide();
        $('#remarksInput').val('');
        loadTaskDropdown();
        applyJobTypeRules();
        $('#startTaskModal').modal('show');
        $('#projectDescription').hide();
    });

    $('#btnConfirmStart').on('click', function () {
        var taskId = $('#taskSelect').val();
        var section = $('#sectionSelect').val();
        var jobType = $('input[name="jobType"]:checked').val();
        var remarks = $('#remarksInput').val();

        if (!taskId || !jobType) {
            $('#startTaskError').text('Please select a task and job type.').show();
            return;
        }

        $(this).prop('disabled', true);

        $.post('/Tracker/StartTask', {
            __RequestVerificationToken: antiForgeryToken(),
            taskId: taskId,
            jobType: jobType,
            section: section,
            remarks: remarks
        }, function (res) {
            $('#btnConfirmStart').prop('disabled', false);
            if (res.flag == 'success') {
                $('#startTaskModal').modal('hide');
                if (res.data) {
                    showRunningPanel(res.data);
                    loadHistory();
                } else {
                    $('#startTaskError').text("Task was not found.").show();
                }
            } else {
                $('#startTaskError').text(res.msg).show();
            }
        }).fail(function () {
            $('#btnConfirmStart').prop('disabled', false);
            $('#startTaskError').text('Unexpected error, please try again.').show();
        });
    });

    $('#btnStopTask').on('click', function () {
        jConfirm('Stop the current task?', 'Info', (e) => {
            if (e) {
                var logId = $('#runningTaskPanel').data('logId');
                $(this).prop('disabled', true);

                $.post('/Tracker/StopTask', {
                    __RequestVerificationToken: antiForgeryToken(),
                    id: logId
                }, function (res) {
                    $('#btnStopTask').prop('disabled', false);
                    if (res.flag == 'success') {
                        showNoTaskPanel();
                        loadHistory();
                    } else {
                        notify(res.msg, res.flag);
                        console.log(res.data);
                    }
                });
            }
        });
    });

    $('#taskSelect').on('change', (x, y) => {
        getProjectDetail(x.target.value);
    });

    function formatSeconds(totalSeconds) {
        const duration = moment.duration(totalSeconds, 'seconds');
        const hours = Math.floor(duration.asHours()); 
        const minutes = duration.minutes();
        const seconds = duration.seconds();

        const parts = [
            hours > 0 ? `${hours}h` : null,
            minutes > 0 ? `${minutes}m` : null,
            seconds > 0 ? `${seconds}s` : null
        ].filter(Boolean); // Removes all null entries
        return parts.join(' ') || '0s';
    }

    function getProjectDetail(uid) {
        $.get('@Url.Action("GetProjectDetail")', { unique_id: uid }, (res) => {
            var content = "";
            if (res.flag == 'success') {
                content = '<p><b>Requesting Department</b> : ' + res.data.requesting_department 
                    + '<br/><b>Project Initiator</b> : ' + (res.data.project_initiator ?? '-')
                    + '<br/><b>Site</b> : ' + (res.data.site_location ?? '-')
                    + '<br/><b>Objective</b> : ' + (res.data.strategy_objective ?? '-') + '</p>'
                $('#projectDescription').html(content);
                $('#projectDescription').show();
            } else {
                $('#projectDescription').html('');
                $('#projectDescription').hide();
                notify(res.msg, res.flag);
                console.log(res.data);
            }
        }).fail(() => {
            $('#projectDescription').hide();
            notify('An error occured because of the network instability. Please try again.', 'error');
        });
    }
</script>
